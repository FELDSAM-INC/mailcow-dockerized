# global_sieve_before script
# global_sieve_before -> user sieve_before (FeldHost™ Mailhosting UI) -> user sieve_after (FeldHost™ Mailhosting UI) -> global_sieve_after

require ["mailbox", "fileinto"];

if header :contains ["Chat-Version"] [""] {
  if mailboxexists "DeltaChat" {
    fileinto "DeltaChat";
  } else {
    fileinto :create "DeltaChat";
  }
  stop;
}
